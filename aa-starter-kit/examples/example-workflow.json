{
  "examples": [
    {
      "name": "미션 업데이트 → LinkedIn 초안 자동 생성",
      "description": "Mission 폴더의 파일이 변경되면 자동으로 Claude가 분석하고 LinkedIn 게시물 초안을 생성합니다.",
      "workflow": {
        "id": "onMissionUpdate",
        "trigger": { "type": "event", "event": "mission:updated" },
        "steps": [
          { "id": "claude-analyze", "name": "Claude 분석 실행" },
          { "id": "linkedin-draft", "name": "LinkedIn 초안 생성" }
        ],
        "errorHandling": { "strategy": "continue", "notifyOnFailure": true }
      },
      "cliUsage": "selfish-club workflow onMissionUpdate"
    },
    {
      "name": "Notion 미팅 → Obsidian 자동 동기화",
      "description": "Notion에 미팅 노트가 추가되면 Obsidian 볼트로 자동 동기화됩니다.",
      "workflow": {
        "id": "onMeetingSync",
        "trigger": { "type": "event", "event": "meeting:synced" },
        "steps": [
          { "id": "notion-fetch", "name": "Notion 미팅 데이터 조회" },
          { "id": "obsidian-sync", "name": "Obsidian 동기화" }
        ],
        "errorHandling": { "strategy": "retry", "maxRetries": 2, "retryDelayMs": 1000 }
      },
      "cliUsage": "selfish-club workflow onMeetingSync"
    },
    {
      "name": "주간 다이제스트 자동 생성 (매주 월요일 9시)",
      "description": "매주 월요일 오전 9시에 주간 활동 요약 보고서를 자동으로 생성하고 GitHub에 커밋합니다.",
      "workflow": {
        "id": "weeklyDigest",
        "trigger": { "type": "cron", "cron": "0 9 * * 1" },
        "steps": [
          { "id": "vault-scan", "name": "볼트 주간 데이터 수집" },
          { "id": "weekly-report", "name": "주간 보고서 생성" },
          { "id": "github-commit", "name": "GitHub 커밋" }
        ],
        "errorHandling": { "strategy": "continue", "notifyOnFailure": true }
      },
      "cliUsage": "selfish-club workflow weeklyDigest"
    },
    {
      "name": "Skill/Insight Vercel 자동 배포",
      "description": "Skills 또는 Insights 폴더에 새 문서가 추가되면 정적 사이트로 빌드하여 Vercel에 자동 배포합니다.",
      "workflow": {
        "id": "onSkillUpdate",
        "trigger": { "type": "event", "event": "skill:updated" },
        "steps": [
          { "id": "site-build", "name": "정적 사이트 빌드" },
          { "id": "vercel-deploy", "name": "Vercel 배포" },
          { "id": "deploy-notify", "name": "배포 알림 전송" }
        ],
        "errorHandling": { "strategy": "stop", "notifyOnFailure": true }
      },
      "cliUsage": "selfish-club deploy --preview"
    }
  ]
}
