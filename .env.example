# ======================================================
# 셀피시 클럽 AI 에이전트 시스템 환경 변수
# ======================================================

# [필수] 프로젝트 핵심 API Keys
GITHUB_TOKEN="your_github_token_here"                 # Required: GitHub Personal Access Token (ghp_... 또는 github_pat_...)
CLAUDE_API_KEY="your_claude_api_key_here"             # Required: Anthropic Claude API Key (sk-ant-api03-...)
NOTION_TOKEN="your_notion_token_here"                 # Required: Notion Integration Token (ntn_... or secret_...)
NOTION_DATABASE_ID="your_notion_database_id_here"     # Required for sync --target notion; DB/data source URL or ID allowed, and the target must be shared with the integration
NOTION_OBSIDIAN_PATH="./vault/meetings"               # Optional: local meetings sync folder
NOTION_TITLE_PROPERTY=""                              # Optional: title property name when auto-detection is not enough

# [선택] 배포
VERCEL_TOKEN="your_vercel_token_here"                 # Optional: Vercel 배포 토큰

# ======================================================
# TaskMaster AI API Keys (태스크 관리용)
# ======================================================
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models.
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features.

# ======================================================
# Optional API smoke test settings
# ======================================================
CLAUDE_MODEL="claude-sonnet-4-6"
GITHUB_OWNER="your_github_owner_here"
GITHUB_REPO="your_github_repo_here"
GITHUB_REMOTE_URL=https://github.com/your-org/your-repo.git
