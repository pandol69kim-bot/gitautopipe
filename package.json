{
  "name": "selfisclub-codex",
  "version": "1.0.0",
  "description": "셀피시 클럽 AI 에이전트 협업 시스템",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:claude": "node --max-old-space-size=8192 node_modules/.bin/vitest run src/integrations/claude.test.ts",
    "test:all": "npm test && npm run test:claude",
    "test:watch": "vitest",
    "test:api": "ts-node scripts/api-smoke-test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@notionhq/client": "^5.20.0",
    "@octokit/rest": "^22.0.1",
    "@types/inquirer": "^8.2.12",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "inquirer": "^8.2.7",
    "simple-git": "^3.36.0",
    "zod": "^4.4.1"
  }
}
